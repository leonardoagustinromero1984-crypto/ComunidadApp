# LeoVer Web — variables públicas (sin secretos reales)
# Copiar a web/.env.local para desarrollo local

# URL canónica de la aplicación web
NEXT_PUBLIC_APP_URL=https://leover.com.ar

# Supabase — mismo proyecto que Android (BuildConfig.SUPABASE_URL / SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
